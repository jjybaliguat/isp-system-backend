generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  password   String
  fullName   String?
  employeeId String? @db.Uuid @unique
  employee   Employees? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  clientId   String? @db.Uuid @unique
  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String    @db.Uuid
  role       UserRole    @default(USER)
  allowAccess Boolean @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs       Log[]

  tickets Ticket[] @relation("createdTickets")

  TicketComment TicketComment[]

  TicketLog TicketLog[]

  conversationParticipants ConversationParticipant[]

  messages Message[]
}

enum UserRole {
  SUPERADMIN
  ADMIN
  USER
  INSTALLER_TECHNICIAN
  CLIENT
}

model Client {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique
  fullName         String
  email            String        @unique
  phoneNumber      String        @unique
  address          String
  installationDate DateTime?     
  terminationDate  DateTime?
  accountNumber    String        @unique
  billingDay      Int?          @default(1) @db.SmallInt
  notes            String?
  mikrotikAccount  String?       
  status           ClientStatus  @default(ACTIVE)
  paymentType     PaymentType  @default(POSTPAID)
  taxStatus       TaxStatus     @default(NOT_ACTIVE)

  // Relations
  servicePlan      ServicePlan?  @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  servicePlanId    String?        @db.Uuid

  provider         Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId       String        @db.Uuid

  clientType       ClientType?   @relation(fields: [clientTypeId], references: [id], onDelete: SetNull)
  clientTypeId     String?       @db.Uuid
  coverageId       String?      @db.Uuid
  coverage         Coverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)

  billings         Billing[]
  payments         Payment[]
  tickets          Ticket[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  odpPort          OdpPort?

  accounts Accounts[]

  users User?
}

model Accounts {
  id            String      @id @default(uuid()) @db.Uuid
  clientId      String      @db.Uuid
  servicePlanId String      @db.Uuid
  clientTypeId     String?       @db.Uuid
  coverageId       String?      @db.Uuid
  accountNumber String      @unique
  createdAt     DateTime    @default(now())
  billingDay      Int?          @default(1) @db.SmallInt
  notes            String?
  mikrotikAccount  String?       
  status           ClientStatus  @default(ACTIVE)
  paymentType     PaymentType  @default(POSTPAID)
  installationDate DateTime? 
  address String?
  taxStatus       TaxStatus     @default(NOT_ACTIVE)

  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  servicePlan   ServicePlan @relation(fields: [servicePlanId], references: [id], onDelete: Cascade)
  clientType       ClientType?   @relation(fields: [clientTypeId], references: [id], onDelete: SetNull)
  coverage         Coverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  odpPort          OdpPort?

  updatedAt     DateTime    @updatedAt

  billings Billing[]

  payments Payment[]
}


enum TaxStatus {
  ACTIVE
  NOT_ACTIVE
}

enum PaymentType {
  PREPAID
  POSTPAID
}

enum ClientStatus {
  ACTIVE
  PARTIALLY_DISCONNECTED
  TERMINATED
}

model Billing {
  id           String    @id @default(uuid()) @db.Uuid
  invoiceNumber String
  clientId     String    @db.Uuid
  accountId  String?           @db.Uuid
  billingDate  DateTime  @default(now())
  period       String?
  dueDate      DateTime
  amount       Float
  discounts    Discount[]
  paidAt       DateTime?
  paidAmount   Float    @default(0)
  status       BillingStatus  @default(PENDING)
  description  String?
  billingType BillingType? @default(REGULAR)
  billingCharges BillingCharges[]
  remarks      String?

  payments     Payment[]

  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account    Accounts? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BillingCharges {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  amount      Float
  description String?
  billingId   String    @db.Uuid
  billing Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum BillingType {
  REGULAR
  PRORATED
  INSTALLATION_FEE
  LATE_FEE
}

model Discount {
  id   String    @id @default(uuid()) @db.Uuid
  description String?
  amount  Float
  billingId String @db.Uuid
  billing Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)
}

model CronJob {
  id           String   @id @default(uuid()) @db.Uuid
  providerId     String
  providerName String
  schedule     String
  type         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([providerId, type], name: "providerId_type")
}

enum BillingStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id             String     @id @default(uuid()) @db.Uuid
  billingId      String     @db.Uuid
  clientId       String     @db.Uuid
  accountId  String?    @db.Uuid
  amount         Decimal    @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  paymentChannel String?
  referenceId    String?    @unique
  xenditInvoiceId String?   @unique
  xenditPaymentUrl String?
  paidAt         DateTime?
  remarks        String?
  recordedBy     String?
  paymentDate    DateTime?
  createdAt      DateTime   @default(now())

  billing        Billing    @relation(fields: [billingId], references: [id], onDelete: Cascade)
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account   Accounts? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

model Provider {
  id               String        @id @default(uuid()) @db.Uuid
  name             String 
  companyName      String
  companyAddress   String
  email            String        @unique
  phoneNumber      String? 
  companyLogoUrl   String? @default("https://res.cloudinary.com/dyjappbhk/image/upload/v1762924997/default-logo_rrbvc5.png")
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  xenditApiKey  String? @unique
  semaphoreApiKey String? @unique
  paymentConvenienceFee Int @default(15)
  invoiceDurationDays Int @default(1)
  dailyBackup Boolean @default(false)
  backUpEmail String?

  // Relations
  clientTypes    ClientType[]
  clients          Client[]
  servicePlans   ServicePlan[]
  coverage       Coverage[]
  users          User[]
  logs           Log[]
  employees      Employees[]
  teams          EmployeesTeam[]
  settings  Json? @default("{}")
  smsIntegrationSettings SmsIntegrationSettings?

  
  /// 🔗 Self relation (Parent → Branches)
  parentProviderId String?  @db.Uuid
  parentProvider   Provider? @relation("ProviderHierarchy", fields: [parentProviderId], references: [id])
  branches         Provider[] @relation("ProviderHierarchy")
  branchStatus BranchStatus @default(ACTIVE)
  providerType ProviderType @default(MAIN)

  Ticket Ticket[]

  olts OLT[]

  lcps LCP[]

  odcs ODC[]

  odps ODP[]

  conversations Conversation[]
  applicants Applicant[]
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ProviderType {
  MAIN
  BRANCH
}

model SmsIntegrationSettings {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @db.Uuid @unique
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sendWhenBillIsMade Boolean @default(false)
  sendWhenBillIsDue Boolean @default(false)
  sendWhenPaymentIsMade Boolean @default(false)
  sendWhenCustomerAdded Boolean @default(false)
  sendDaysBeforeDueEnabled    Boolean @default(false)
  sendDaysBeforeDueDays       Int?

  sendWhenBillIsMadeTemplate String?
  sendWhenBillIsDueTemplate String?
  sendWhenPaymentIsMadeTemplate String?
  sendWhenCustomerAddedTemplate String?
  sendDaysBeforeDueTemplate String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coverage {
  id               String        @id @default(uuid()) @db.Uuid
  name  String
  latitude Float
  longitude Float
  radius  Int? @default(200)
  providerId  String  @db.Uuid
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  clients Client[]
  accounts Accounts[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, providerId])
  applicants Applicant[]
}

model ServicePlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   
  speedMbps    Float
  monthlyFee   Float
  isActive     Boolean  @default(true)
  descriptions String[]
  showToWebsite Boolean @default(false)

  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId   String   @db.Uuid

  clients      Client[]

  accounts Accounts[]

  applicants Applicant[]
}


enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model ClientType {
  id       String   @id @default(uuid()) @db.Uuid
  name String  
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String @db.Uuid

  clients  Client[]
  accounts Accounts[]

  @@unique([name, providerId])
}

model Log {
  id        String    @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  userId    String?    @db.Uuid
  createdAt DateTime   @default(now())
  message   String?

  user      User?      @relation(fields: [userId], references: [id])
  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  ticketNumber String
  subject      String
  description  String?
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(PENDING)
  category     TicketCategory  @default(GENERAL)
  attachments  String[] 
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  dueDate      DateTime?    

  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId     String?         @db.Uuid

  assignedToTeam   EmployeesTeam?  @relation("assignedTickets", fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  assignedToTeamId String?         @db.Uuid
  assignedToEmployeeId String?         @db.Uuid
  assignedToEmployee   Employees?  @relation("assignedTickets", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)

  createdBy    User?           @relation("createdTickets", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?         @db.Uuid

  provider     Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId   String          @db.Uuid

  comments     TicketComment[]
  activityLogs TicketLog[]
}

model TicketComment {
  id         String    @id @default(uuid()) @db.Uuid
  message    String
  createdAt  DateTime  @default(now())

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String    @db.Uuid

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?   @db.Uuid
}

model TicketLog {
  id         String    @id @default(uuid()) @db.Uuid
  action     String
  createdAt  DateTime  @default(now())

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String    @db.Uuid

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?   @db.Uuid
}

model Employees {
  id String    @id @default(uuid()) @db.Uuid
  fullName  String
  email     String @unique
  phoneNumber String
  address String
  role String
  status EmployeeStatus @default(ACTIVE)
  hireDate  DateTime
  teamId  String? @db.Uuid
  team   EmployeesTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  providerId String @db.Uuid
  provider Provider @relation(fields: [providerId], references: [id])
  user User?

  createdAt DateTime @default(now())

  Ticket Ticket[] @relation("assignedTickets")
}

model EmployeesTeam {
  id String    @id @default(uuid()) @db.Uuid
  name String
  providerId String @db.Uuid
  provider Provider @relation(fields: [providerId], references: [id])
  assignedTickets Ticket[] @relation("assignedTickets")

  employees Employees[]
}

model OLT {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  brand       String?
  model       String?
  ponCount    Int
  ipAddress   String?
  location    String?
  latitude    Float?
  longitude   Float?
  remarks     String?

  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String    @db.Uuid

  ponPorts    PonPort[]
  lcps        LCP[]     // convenience relation for quick lookup
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PonPort {
  id          String     @id @default(uuid()) @db.Uuid
  portNumber  Int
  description String?
  status      PonPortStatus @default(ACTIVE)

  olt         OLT        @relation(fields: [oltId], references: [id], onDelete: Cascade)
  oltId       String     @db.Uuid

  lcps        LCP[]      // one PON port can serve multiple LCPs
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([oltId, portNumber]) // prevent duplicate port numbers on same OLT
}

enum PonPortStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model LCP {
  id          String    @id @default(uuid()) @db.Uuid
  lcpCode        String
  location    String?
  latitude    Float?
  longitude   Float?
  remarks     String?

  ponPort     PonPort   @relation(fields: [ponPortId], references: [id], onDelete: Cascade)
  ponPortId   String    @db.Uuid

  olt         OLT       @relation(fields: [oltId], references: [id], onDelete: Cascade)
  oltId       String    @db.Uuid

  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String    @db.Uuid

  odcs        ODC[]
  odps        ODP[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ODC {
  id          String   @id @default(uuid()) @db.Uuid
  name        String?
  cabinetCode String?  @unique
  location    String?
  latitude    Float?
  longitude   Float?
  remarks     String?

  lcp         LCP      @relation(fields: [lcpId], references: [id], onDelete: Cascade)
  lcpId       String   @db.Uuid

  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String   @db.Uuid

  odps        ODP[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ODP {
  id          String   @id @default(uuid()) @db.Uuid
  // name        String
  odpCode     String?  @unique
  portCount   Int      @default(8)
  location    String?
  latitude    Float?
  longitude   Float?
  remarks     String?

  odc         ODC?      @relation(fields: [odcId], references: [id], onDelete: Cascade)
  odcId       String?   @db.Uuid
  lcpId       String? @db.Uuid
  lcp         LCP? @relation(fields: [lcpId], references: [id], onDelete: Cascade)

  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId  String   @db.Uuid

  ports       OdpPort[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OdpPort {
  id          String   @id @default(uuid()) @db.Uuid
  portNumber  Int
  status      PortStatus @default(AVAILABLE)
  remarks     String?

  odp         ODP      @relation(fields: [odpId], references: [id], onDelete: Cascade)
  odpId       String   @db.Uuid

  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?     @unique @db.Uuid
  accountId String? @unique @db.Uuid
  account Accounts? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([odpId, portNumber]) // prevent duplicate port numbers in same ODP
}

enum PortStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DAMAGED
}


enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  PENDING
  ONGOING
  RESOLVED
  CLOSED
  OVERDUE
}

enum TicketCategory {
  BILLING
  TECHNICAL
  INSTALLATION
  SERVICE
  REPAIR
  GENERAL
}

model Applicant {
  id String @id @default(uuid()) @db.Uuid
  name         String
  applicationNumber String? @unique
  email        String  @unique
  phone        String?
  address      String?
  notes        String?
  idType       String
  idCardNumber  String?
  coverageId   String? @db.Uuid
  coverage     Coverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  servicePlanId String? @db.Uuid
  servicePlan  ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  providerId   String? @db.Uuid
  provider     Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  applicationStatus ApplicationStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ApplicationStatus {
  PENDING
  PROCESSING
  ONGOING
  INSTALLED
  REJECTED
  CANCELLED
}

// System's chat models

// -------------------------------------
// Conversations (for 1-1 or group chats)
// -------------------------------------
model Conversation {
  id          String          @id @default(uuid()) @db.Uuid
  providerId  String          @db.Uuid
  provider    Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // True = group chat, False = direct message between two users
  isGroup     Boolean         @default(false)

  name        String?         // optional: for group chats
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  participants ConversationParticipant[]
  messages      Message[]
}


// -------------------------------------
// Who belongs to a conversation
// -------------------------------------
model ConversationParticipant {
  id              String        @id @default(uuid()) @db.Uuid
  conversationId  String        @db.Uuid
  userId          String        @db.Uuid
  joinedAt        DateTime      @default(now())

  // last time user read messages in this conversation
  lastReadAt      DateTime?     

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId]) // prevent duplicates
}


// -------------------------------------
// Messages
// -------------------------------------
model Message {
  id              String        @id @default(uuid()) @db.Uuid
  conversationId  String        @db.Uuid
  senderId        String        @db.Uuid

  content         String?       // null if attachment only
  attachments     Json?         // [{url, fileName, size, type}, ...]

  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // For indexing messages by conversation
  @@index([conversationId, createdAt])
}

model PppoeBandwidth {
  id          Int      @id @default(autoincrement())
  username    String
  rx_mbps     Float
  tx_mbps     Float
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([username, recordedAt], name: "idx_pppoe_user_time")
  @@map("pppoe_bandwidth")
}

model PppoeLatest {
  username    String   @id
  rx_mbps     Float
  tx_mbps     Float
  recordedAt  DateTime

  @@map("pppoe_latest")
}

